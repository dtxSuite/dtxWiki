# dtxWiki Docker Compose config.
# Copy to `.env` next to docker-compose.yml, then set the two values below.
# Secrets, JWT keys, the database, and TLS certs are all handled by the stack
# automatically. The initial dtxWiki user is provisioned after first boot.
#
#   cd infra/prod && cp .env.docker.example .env && docker compose up -d --build

# ============================================================
#  EDIT THESE (2)
# ============================================================

# Public HTTPS domain. DNS A record must point at this host; 80/443 must be open.
DTXWIKI_DOMAIN=wiki.example.com

# Certificate-contact email — Let's Encrypt notices only.
# NOTE: public signup does NOT grant server-admin. After first boot, provision
# the local account (with its Personal workspace) and then grant server-admin.
# `users add` prompts twice for a hidden password; do not put it in shell history:
#   docker compose exec app dtxwiki users add admin@example.com
#   docker compose exec app dtxwiki admin grant --email admin@example.com
# (While the app container is stopped: docker compose run --rm app dtxwiki ...)
DTXWIKI_ADMIN_EMAIL=admin@example.com

# ============================================================
#  Optional
# ============================================================

# ---- Internal network / no public domain (internal CA) ----
# No public DNS? Serve an internal name/IP over HTTPS with Caddy's local CA, then
# distribute the root CA to clients. DTXWIKI_ADMIN_EMAIL is not needed here.
#   DTXWIKI_DOMAIN=wiki.lan
#   DTXWIKI_TLS_MODE=internal
#   DTXWIKI_CADDYFILE=./Caddyfile.docker.internal
# Export the root CA for client trust stores:
#   docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./dtxwiki-root.crt

# Session secret: leave EMPTY. On first start the container generates a random
# one into /var/lib/dtxwiki/session_secret on the data volume (0600, kept across
# restarts and image updates) and every service reads it from there. To pin
# your own instead, generate it once and paste it here; a value set here always
# wins over the file:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DTXWIKI_SESSION_SECRET=

# Browser session lifetime policy (seconds). Ordinary sessions are absolute
# and non-sliding. Remembered sessions renew through successful /auth/me calls
# only near expiry and never beyond 90 days from the original login.
DTXWIKI_SESSION_TTL_SECONDS=43200
DTXWIKI_SESSION_REMEMBERED_TTL_SECONDS=2592000
DTXWIKI_SESSION_REMEMBERED_REFRESH_THRESHOLD_SECONDS=604800
DTXWIKI_SESSION_REMEMBERED_ABSOLUTE_TTL_SECONDS=7776000

# Team mode disables self-signup by default. Set true only when public
# self-service registration with a private Personal Workspace is intentional.
DTXWIKI_SIGNUP_ENABLED=false

# Account recovery defaults to administrator-assisted one-time links. To enable
# verified-email recovery, configure SMTP; never commit a populated .env file.
DTXWIKI_MAIL_PROVIDER=none
# DTXWIKI_MAIL_FROM_ADDRESS=wiki@example.com
# DTXWIKI_SMTP_HOST=smtp.example.com
# DTXWIKI_SMTP_PORT=587
# DTXWIKI_SMTP_USERNAME=<smtp-username>
# DTXWIKI_SMTP_PASSWORD=<smtp-secret>
# DTXWIKI_SMTP_STARTTLS=true
# DTXWIKI_SMTP_USE_SSL=false
# DTXWIKI_SMTP_TIMEOUT_SECONDS=10

# ---- Updates (optional) ----
# Optional trusted package index/proxy used while building this checkout. It
# must provide all dependencies; public/private extra-index mixing is disabled.
# PIP_INDEX_URL=https://pypi.internal/simple
#
# Container-registry update path: set a FULL immutable image reference and
# `docker compose pull && docker compose up -d` instead of building.
# DTXWIKI_IMAGE=registry.example.com/dtxwiki:0.2.2
