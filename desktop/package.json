{
  "name": "@dtxwiki/desktop",
  "version": "0.2.3",
  "private": true,
  "license": "AGPL-3.0-only OR Elastic-2.0",
  "description": "dtxWiki desktop shell for local and remote servers",
  "author": "dtxSuite",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:engine-stop": "node --test tests/blocked-engine.integration.cjs",
    "pack": "electron-builder --config electron-builder.config.cjs --dir",
    "build:pack": "electron-builder --config electron-builder.config.cjs --dir",
    "build:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "build:mac": "electron-builder --config electron-builder.config.cjs --mac dmg zip"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.dtxsuite.dtxwiki",
    "productName": "dtxWiki",
    "icon": "assets/icon.svg",
    "copyright": "Copyright © 2026 Minsoo Kim (dtxSuite)",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine"
      },
      {
        "from": "../LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "../LICENSE-AGPL-3.0",
        "to": "licenses/LICENSE-AGPL-3.0"
      },
      {
        "from": "../LICENSE-ELv2",
        "to": "licenses/LICENSE-ELv2"
      },
      {
        "from": "../NOTICE",
        "to": "licenses/NOTICE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "dtxWiki-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "dtxWiki",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "dtxWiki-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist"
    },
    "dmg": {
      "title": "dtxWiki ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
